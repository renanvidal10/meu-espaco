# Copie este arquivo para ".env" (mesma pasta) e preencha com os valores reais.
# NUNCA envie o arquivo ".env" para o git — ele já está no .gitignore.

# ─────────────────────────────────────────────────────────────
# OBRIGATÓRIO — extração clínica por IA
# ─────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-coloque-sua-chave-aqui

# ─────────────────────────────────────────────────────────────
# OBRIGATÓRIO EM PRODUÇÃO — banco de dados
# Sem isso, as contas dos médicos são apagadas a cada deploy
# (o disco do Render é efêmero). O servidor recusa subir em
# produção sem esta variável, de propósito.
# Postgres gratuito: neon.tech ou supabase.com
# ─────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://usuario:senha@host/banco?sslmode=require

# ─────────────────────────────────────────────────────────────
# OBRIGATÓRIO EM PRODUÇÃO — envio de email
# Sem isso, o link de definição de senha não chega ao médico e
# ninguém consegue concluir o primeiro acesso.
# Chave gratuita: resend.com/api-keys
# ─────────────────────────────────────────────────────────────
RESEND_API_KEY=re_coloque_sua_chave_aqui

# Remetente. Enquanto não houver domínio próprio verificado no
# Resend, mantenha o endereço de teste abaixo (só entrega para o
# email dono da conta Resend). Com domínio verificado, troque
# por algo como: OncoGenYX <acesso@seudominio.com.br>
MAIL_FROM=OncoGenYX <onboarding@resend.dev>

# ─────────────────────────────────────────────────────────────
# RECOMENDADO
# ─────────────────────────────────────────────────────────────
# Segredo usado para assinar o "state" do OAuth. Gere um valor
# aleatório longo. Se ausente, é sorteado a cada boot — o que
# invalida conexões OAuth em andamento a cada reinício.
SESSION_SECRET=

# Endereço público da aplicação, usado para montar os links dos
# emails. Em produção: https://oncogenyx.onrender.com
APP_ORIGIN=

# Marque como produção para ativar as travas de segurança do boot.
NODE_ENV=development

# Porta local do servidor (o Render define isso sozinho)
PORT=3000

# ─────────────────────────────────────────────────────────────
# OPCIONAL — integração com o gravador Plaud
# Só preencha depois que o acesso for aprovado em dev.plaud.ai.
# Enquanto estiver vazio, a UI mostra o estado honesto de
# "aguardando liberação" e não simula nenhuma transcrição.
# ─────────────────────────────────────────────────────────────
PLAUD_CLIENT_ID=
PLAUD_CLIENT_SECRET=
# Deixe em branco para deduzir automaticamente do host da requisição.
PLAUD_REDIRECT_URI=
