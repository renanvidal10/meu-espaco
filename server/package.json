{
  "name": "oncogenyx-server",
  "version": "0.1.0",
  "description": "Backend real do OncoGenYX — extracao de caso clinico via API da Anthropic (texto, PDF, imagem).",
  "main": "index.js",
  "type": "commonjs",
  "scripts": {
    "start": "node index.js",
    "dev": "node index.js",
    "test": "node --test test/*.test.js",
    "test:navegador": "node test/navegador.js",
    "test:contraste": "node test/contraste.js",
    "test:a11y": "node test/acessibilidade.js",
    "test:tudo": "npm test && npm run test:navegador && npm run test:contraste && npm run test:a11y"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "helmet": "^8.3.0",
    "multer": "^2.2.0",
    "pg": "^8.23.0",
    "unpdf": "^1.8.0"
  },
  "devDependencies": {
    "playwright": "^1.56.1"
  },
  "engines": {
    "node": ">=18"
  }
}
